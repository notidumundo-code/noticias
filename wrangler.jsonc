{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noticias-globales",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Login attempts: 5 per minute per IP+email (free Workers rate limiting).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Every minute; each run refreshes FEEDS_PER_RUN feeds, so every source is re-read
  // about every 15 minutes with ~30 feeds while each run stays within the free plan's
  // 10 ms CPU limit.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "FEEDS_PER_RUN": "2"
    // Secrets (set with `wrangler secret put` or in the dashboard, never here):
    //   SUPABASE_URL, SUPABASE_SECRET_KEY, ALLOWED_EMAILS (comma-separated)
  }
}
