{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noticias-globales",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Every 5 minutes; each run refreshes FEEDS_PER_RUN feeds, so every source
  // is re-read roughly every 25 minutes with ~30 feeds.
  // Login attempts: 5 per minute per IP+email (free Workers rate limiting).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "FEEDS_PER_RUN": "6"
    // Secrets (set with `wrangler secret put` or in the dashboard, never here):
    //   SUPABASE_URL, SUPABASE_SECRET_KEY, ALLOWED_EMAILS (comma-separated)
  }
}
